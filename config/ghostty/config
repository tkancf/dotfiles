# Config generated by Ghostty Config

# Font Settings
font-family = ""
font-family = "Hack Nerd Font Mono"
# MonacoをHack Nerd Fontのfallbackに入れないと、"※" が全角表示されて次の文字と重なる
font-family = "Monaco"
# MenloをMonacoのfallbackが終わった後のフォールバック先として設定すると、"✔"のサイズがいい感じ
font-family = "Menlo"
# 全角スペースの可視化、日本語用フォント
font-family = "HackGen Console NF"
font-feature = "-calt"
font-feature = "-dlig"
font-feature = "-liga"
font-size = 16

shell-integration = fish
custom-shader-animation = true
clipboard-read = allow
clipboard-write = allow
copy-on-select = true
macos-option-as-alt = true

# Theme Settings
#theme = "wombat"
theme = TokyoNight Moon